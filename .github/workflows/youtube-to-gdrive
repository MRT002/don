name: Download YouTube Audio

on:
  workflow_dispatch:
    inputs:
      links:
        description: 'لینک‌های یوتیوب (هر لینک در یک خط)'
        required: true
        type: textarea

jobs:
  download-and-save:
    runs-on: ubuntu-latest

    # دسترسی لازم برای پوش کردن فایل‌ها به مخزن
    permissions:
      contents: write

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Install yt-dlp
        uses: AnimMouse/setup-yt-dlp@v3
        with:
          with-ffmpeg: true

      - name: Download Audio (64kbps MP3)
        run: |
          echo "${{ github.event.inputs.links }}" > links.txt
          
          while IFS= read -r line || [ -n "$line" ]; do
            url=$(echo "$line" | xargs)
            if [ ! -z "$url" ]; then
              yt-dlp \
                -f "bestaudio/best" \
                --extract-audio \
                --audio-format mp3 \
                --audio-quality 64K \
                --output "%(title)s.%(ext)s" \
                --ignore-errors \
                --no-warnings \
                "$url"
            fi
          done < links.txt

          # پاک کردن فایل موقت لینک‌ها
          rm links.txt

      - name: Commit and Push to Repository
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "41898282+github-actions[bot]@users.noreply.github.com"
          
          # اضافه کردن تمام فایل‌های mp3 با هر اسمی که دارن
          git add *.mp3
          
          # بررسی اینکه آیا فایل جدیدی اضافه شده یا نه، برای جلوگیری از ارور
          if git diff --cached --quiet; then
            echo "هیچ فایل جدیدی دانلود نشد."
          else
            git commit -m "دانلود خودکار صوت‌های یوتیوب"
            git push
          fi
