name: دانلود صوت 64kbps از یوتیوب

on:
  workflow_dispatch:
    inputs:
      links:
        description: 'لینک‌های یوتیوب (هر لینک یک خط)'
        required: true
        type: textarea

jobs:
  download-audio:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: نصب yt-dlp و FFmpeg
        uses: AnimMouse/setup-yt-dlp@v3

      - name: نصب FFmpeg
        uses: FedericoCarboni/setup-ffmpeg@v3

      - name: ذخیره لینک‌ها
        run: |
          cat > links.txt << 'EOL'
          ${{ inputs.links }}
          EOL

      - name: دانلود صوت با کیفیت 64kbps
        run: |
          yt-dlp \
            -f "bestaudio/best" \
            --extract-audio \
            --audio-format mp3 \
            --audio-quality 64K \
            --output "%(title)s.%(ext)s" \
            --ignore-errors \
            --no-warnings \
            -a links.txt

      - name: آماده‌سازی برای دانلود (Artifact)
        uses: actions/upload-artifact@v4
        with:
          name: youtube-64kbps-audio
          path: "*.mp3"
          retention-days: 7
