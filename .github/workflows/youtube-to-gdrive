name: دانلود صوت یوتیوب 64kbps

on:
  workflow_dispatch:
    inputs:
      links:
        description: 'لینک‌ها رو اینجا paste کن (هر لینک یک خط)'
        required: true
        type: textarea

jobs:
  download:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup yt-dlp
        uses: AnimMouse/setup-yt-dlp@v3

      - name: Setup FFmpeg
        uses: FedericoCarboni/setup-ffmpeg@v3

      - name: ذخیره لینک‌ها
        run: |
          cat > links.txt << 'EOL'
          ${{ inputs.links }}
          EOL

      - name: دانلود صوت 64kbps
        run: |
          yt-dlp -f "bestaudio/best" \
            --extract-audio \
            --audio-format mp3 \
            --audio-quality 64K \
            --output "%(title)s.%(ext)s" \
            --ignore-errors \
            -a links.txt

      - name: آماده کردن فایل‌ها برای دانلود
        uses: actions/upload-artifact@v4
        with:
          name: downloaded-audios
          path: "*.mp3"
          retention-days: 5
