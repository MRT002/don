name: Download YouTube Audio

on:
  workflow_dispatch:
    inputs:
      links:
        description: 'لینک‌های یوتیوب (هر لینک در یک خط)'
        required: true
        type: textarea

jobs:
  download-and-upload:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Install yt-dlp
        uses: AnimMouse/setup-yt-dlp@v3
        with:
          with-ffmpeg: true

      - name: Save Links to File
        run: |
          cat << 'EOF' > links.txt
          ${{ github.event.inputs.links }}
          EOF

      - name: Download Audio (64kbps MP3)
        run: |
          yt-dlp \
            -f "bestaudio/best" \
            --extract-audio \
            --audio-format mp3 \
            --audio-quality 64K \
            --output "%(title)s.%(ext)s" \
            --ignore-errors \
            --no-warnings \
            -a links.txt

      - name: Upload Artifact
        uses: actions/upload-artifact@v4
        with:
          name: youtube-audio-files
          path: |
            *.mp3
          retention-days: 7
