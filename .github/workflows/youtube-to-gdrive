name: Download YouTube Audio

on:
  workflow_dispatch:
    inputs:
      links:
        description: 'لینک‌های یوتیوب'
        required: true
        type: textarea

jobs:
  download-and-save:
    runs-on: ubuntu-latest

    permissions:
      contents: write

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Install yt-dlp
        uses: AnimMouse/setup-yt-dlp@v3
        with:
          with-ffmpeg: true

      - name: Download Audio (64kbps MP3)
        env:
          YOUTUBE_LINKS: ${{ github.event.inputs.links }}
        run: |
          # ذخیره لینک‌ها در یک فایل با حفظ دقیق شکستگی خطوط
          printf "%s" "$YOUTUBE_LINKS" > raw_links.txt
          
          # تمیزکاری و آماده‌سازی لینک‌ها
          sed -i 's/\r//g' raw_links.txt
          
          # دانلود تک به تک بدون استفاده از آپشن -a که حساس به فرمت فایل است
          while IFS= read -r line || [ -n "$line" ]; do
            # حذف فاصله‌های خالی احتمالی اطراف لینک
            url=$(echo "$line" | xargs)
            
            # بررسی اینکه خط خالی نباشد و با http شروع شود
            if [[ ! -z "$url" && "$url" == http* ]]; then
              echo "در حال دانلود: $url"
              yt-dlp \
                -f "bestaudio/best" \
                --extract-audio \
                --audio-format mp3 \
                --audio-quality 64K \
                --output "%(title)s.%(ext)s" \
                --ignore-errors \
                --no-warnings \
                "$url"
            fi
          done < raw_links.txt

          rm -f raw_links.txt

      - name: Commit and Push to Repository
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "41898282+github-actions[bot]@users.noreply.github.com"
          
          # اضافه کردن تمام فایل‌های mp3 با هر اسمی که دارند
          git add *.mp3
          
          if git diff --cached --quiet; then
            echo "هیچ فایل جدیدی برای ذخیره پیدا نشد."
          else
            git commit -m "ذخیره خودکار فایل‌های صوتی یوتیوب"
            git push
          fi
